# Copy this file to .env  (Windows: copy .env.example .env)   -  never commit .env
#
# NOTHING HERE IS REQUIRED. With an empty or missing .env the app still extracts the
# fact sheet, still builds the cross-check table, and still answers questions by exact
# field lookup with citations. The key only buys fluent phrasing.
#
# The provider is picked automatically from whichever key is set; set LLM_PROVIDER to
# choose deliberately (groq | openai | gemini | ollama | none).

LLM_PROVIDER=
#LLM_PROVIDER=groq

# --- free tiers (recommended for the demo) -------------------------------------
GROQ_API_KEY=
#LLM_MODEL=llama-3.3-70b-versatile
# Groq's model list is account-specific: check it before setting LLM_MODEL -
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
# A name that is not on your list fails, and the app then answers deterministically
# (mode: limited) rather than pretending the model spoke. Verified working on 2026-10-26:
#   LLM_MODEL=openai/gpt-oss-120b
# Free-tier Groq keys are limited to 8,000 tokens/minute (measured header on 2026-10-26,
# same for gpt-oss-120b and gpt-oss-20b). One question here costs ~4,200 prompt tokens plus
# ~700 answer tokens, so ask about one question per 40-60 s, or raise the account limit.
# When a model is out of quota the client tries the next model on the same key:
#LLM_FALLBACK_MODELS=openai/gpt-oss-20b     # Groq default when this line is absent
#LLM_FALLBACK_MODELS=none                   # switch the hand-over off
# If every model is out, the answer is the deterministic lookup (mode: limited) with a
# one-line "usage limit reached" note - the provider's raw 429 body never reaches the chat.

OPENAI_API_KEY=
#LLM_MODEL=gpt-4o-mini

GEMINI_API_KEY=
#LLM_MODEL=gemini-2.0-flash

# --- local, no key, no internet ------------------------------------------------
#OLLAMA_BASE_URL=http://localhost:11434
#LLM_PROVIDER=ollama
#LLM_MODEL=llama3.1

# --- overrides for any other OpenAI-compatible endpoint ------------------------
#OPENAI_BASE_URL=https://my-gateway/v1
#GEMINI_BASE_URL=https://my-gateway/v1beta

# Use `none` to switch the language model off even when a key is present.
#LLM_PROVIDER=none
